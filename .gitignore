# ==========================================
# Root .gitignore for DesignOPack-MERN
# ==========================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
*.env
!.env.example
!*.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Build Artifacts
dist/
dist-ssr/
frontend/dist/
build/
backend/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
